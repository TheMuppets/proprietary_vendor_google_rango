<!-- Rango Configuration -->
<displayConfiguration>
    <name>Inner Display</name>
    <screenBrightnessMap>
        <point>
            <value>0.0</value>
            <nits>1.0</nits>
        </point>
        <point>
            <value>0.68</value>
            <nits>1250</nits>
        </point>
        <point>
            <value>1.0</value>
            <nits>1850</nits>
        </point>
    </screenBrightnessMap>

    <!-- 140 nits: (140-1.0)/(1250.0-1.0)*(0.68-0.0)+0.0 = 0.075676541 -->
    <screenBrightnessDefault>0.075676541</screenBrightnessDefault>

    <highBrightnessMode enabled="true">
        <transitionPoint>0.68</transitionPoint>
        <minimumLux>10000</minimumLux>
        <timing>
            <!-- allow for 5 minutes out of every 20 minutes -->
            <timeWindowSecs>1200</timeWindowSecs>
            <timeMaxSecs>300</timeMaxSecs>
            <timeMinSecs>60</timeMinSecs>
        </timing>
        <allowInLowPowerMode>false</allowInLowPowerMode>
        <minimumHdrPercentOfScreen>0</minimumHdrPercentOfScreen>
        <!--sdrHdrRatioMap, backed by spline, must have at least two entries -->
        <sdrHdrRatioMap>
            <point>
                <sdrNits>1.000</sdrNits>
                <hdrRatio>2.000</hdrRatio>
            </point>
            <point>
                <sdrNits>2.000</sdrNits>
                 <hdrRatio>4.000</hdrRatio>
            </point>
            <point>
                <sdrNits>5.000</sdrNits>
                <hdrRatio>4.000</hdrRatio>
            </point>
            <point>
                <sdrNits>100.000</sdrNits>
                <hdrRatio>8.000</hdrRatio>
            </point>
        </sdrHdrRatioMap>
    </highBrightnessMode>

    <hdrBrightnessConfig>
        <brightnessMap>
            <point>
                <first>10.0</first>
                <!-- 1600 nits: (1600-1250)/(1850-1250)*(1.0-0.68)+0.68 = 0.866666667 -->
                <second>0.866666667</second>
            </point>
        </brightnessMap>
        <brightnessIncreaseDebounceMillis>10000</brightnessIncreaseDebounceMillis>
        <screenBrightnessRampIncrease>0.004</screenBrightnessRampIncrease>
        <brightnessDecreaseDebounceMillis>5000</brightnessDecreaseDebounceMillis>
        <screenBrightnessRampDecrease>0.004</screenBrightnessRampDecrease>
    </hdrBrightnessConfig>

    <autoBrightness enabled="true">
    </autoBrightness>

    <lightSensor>
        <type>com.google.sensor.auto_brightness</type>
        <name>Auto Brightness 0</name>
    </lightSensor>

    <proxSensor>
        <type></type>
        <name></name>
    </proxSensor>

    <tempSensor>
        <type>DISPLAY</type>
        <name>VIRTUAL-SKIN-INNER-DISPLAY</name>
    </tempSensor>

    <screenBrightnessRampIncreaseMaxMillis>2000</screenBrightnessRampIncreaseMaxMillis>
    <screenBrightnessRampDecreaseMaxMillis>20000</screenBrightnessRampDecreaseMaxMillis>

    <ambientBrightnessChangeThresholds>
        <brighteningThresholds>
            <minimum>10</minimum>
        </brighteningThresholds>
        <darkeningThresholds>
            <minimum>0</minimum>
        </darkeningThresholds>
    </ambientBrightnessChangeThresholds>

    <ambientLightHorizonLong>5000</ambientLightHorizonLong>
    <ambientLightHorizonShort>50</ambientLightHorizonShort>

    <thermalThrottling>
        <brightnessThrottlingMap>
            <brightnessThrottlingPoint>
                <thermalStatus>light</thermalStatus>
                <!-- Throttling to 526 nits: (526-1.0)/(1250.0-1.0)*(0.68-0.0)+0.0 -->
                <brightness>0.285828663</brightness>
            </brightnessThrottlingPoint>
            <brightnessThrottlingPoint>
                <thermalStatus>moderate</thermalStatus>
                <!-- Throttling to 358 nits: (358-1.0)/(1250.0-1.0)*(0.68-0.0)+0.0 -->
                <brightness>0.194363491</brightness>
            </brightnessThrottlingPoint>
            <brightnessThrottlingPoint>
                <thermalStatus>severe</thermalStatus>
                <!-- Throttling to 279 nits: (279-1.0)/(1250.0-1.0)*(0.68-0.0)+0.0 -->
                <brightness>0.151353083</brightness>
            </brightnessThrottlingPoint>
            <brightnessThrottlingPoint>
                <thermalStatus>critical</thermalStatus>
                <!-- Throttling to 200 nits: (200-1.0)/(1250.0-1.0)*(0.68-0.0)+0.0 -->
                <brightness>0.108342674</brightness>
            </brightnessThrottlingPoint>
        </brightnessThrottlingMap>
        <!-- Concurrent display mode map -->
        <brightnessThrottlingMap id="concurrent">
            <brightnessThrottlingPoint>
                <thermalStatus>light</thermalStatus>
                <!-- Throttling to 358 nits: (358-1.0)/(1250.0-1.0)*(0.68-0.0)+0.0 -->
                <brightness>0.194363491</brightness>
            </brightnessThrottlingPoint>
            <brightnessThrottlingPoint>
                <thermalStatus>moderate</thermalStatus>
                <!-- Throttling to 279 nits: (279-1.0)/(1250.0-1.0)*(0.68-0.0)+0.0 -->
                <brightness>0.151353083</brightness>
            </brightnessThrottlingPoint>
            <brightnessThrottlingPoint>
                <thermalStatus>severe</thermalStatus>
                <!-- Throttling to 200 nits: (200-1.0)/(1250.0-1.0)*(0.68-0.0)+0.0 -->
                <brightness>0.108342674</brightness>
            </brightnessThrottlingPoint>
        </brightnessThrottlingMap>

        <!-- default refreshRate throttling map -->
        <refreshRateThrottlingMap>
            <refreshRateThrottlingPoint>
                <!-- for thermal status critical -->
                <thermalStatus>critical</thermalStatus>
                <refreshRateRange>
                    <minimum>0</minimum>
                    <maximum>60</maximum>
                </refreshRateRange>
            </refreshRateThrottlingPoint>
            <refreshRateThrottlingPoint>
                <!-- for thermal status emergency and above -->
                <thermalStatus>emergency</thermalStatus>
                <refreshRateRange>
                    <minimum>0</minimum>
                    <maximum>30</maximum>
                </refreshRateRange>
            </refreshRateThrottlingPoint>
        </refreshRateThrottlingMap>
        <refreshRateThrottlingMap id="concurrent">
            <refreshRateThrottlingPoint>
                <!-- for thermal status critical and above -->
                <thermalStatus>critical</thermalStatus>
                <refreshRateRange>
                    <minimum>0</minimum>
                    <maximum>60</maximum>
                </refreshRateRange>
            </refreshRateThrottlingPoint>
        </refreshRateThrottlingMap>
    </thermalThrottling>

    <screenBrightnessRampFastDecrease>0.7047244</screenBrightnessRampFastDecrease>
    <screenBrightnessRampFastIncrease>0.7047244</screenBrightnessRampFastIncrease>
    <screenBrightnessRampSlowDecrease>0.024</screenBrightnessRampSlowDecrease>
    <screenBrightnessRampSlowIncrease>0.05</screenBrightnessRampSlowIncrease>

    <screenOffBrightnessSensor>
        <type>com.google.sensor.binned_brightness</type>
        <name>Binned Brightness 0 (wake-up)</name>
    </screenOffBrightnessSensor>
    <screenOffBrightnessSensorValueToLux>
        <item>-1</item> <!-- 0: OFF -->
        <item>0</item>  <!-- 1: NIGHT -->
        <item>5</item>  <!-- 2: LOW -->
        <item>80</item> <!-- 3: HIGH -->
        <item>1500</item> <!-- 4: SUN -->
    </screenOffBrightnessSensorValueToLux>

    <refreshRate>
        <refreshRateZoneProfiles>
            <refreshRateZoneProfile id="concurrent">
                <refreshRateRange>
                    <minimum>60</minimum>
                    <maximum>60</maximum>
                </refreshRateRange>
            </refreshRateZoneProfile>
        </refreshRateZoneProfiles>
    </refreshRate>

    <luxThrottling>
        <brightnessLimitMap>
            <type>adaptive</type>
            <map>
                <point>
                    <first>1000</first>
                    <!-- 600 nits (600-1.0)/(1250.0-1.0)*(0.68-0.0)+0.0 = 0.326116894 -->
                    <second>0.326116894</second>
                </point>
                <point>
                    <first>6000</first>
                    <!-- 850 nits (850-1.0)/(1250.0-1.0)*(0.68-0.0)+0.0 = 0.462225781 -->
                    <second>0.462225781</second>
                </point>
                <point>
                    <first>10000</first>
                    <!-- 1000 nits (1000-1.0)/(1250.0-1.0)*(0.68-0.0)+0.0 = 0.543891113 -->
                    <second>0.543891113</second>
                </point>
            </map>
        </brightnessLimitMap>
    </luxThrottling>

    <supportsVrr>true</supportsVrr>

    <dozeBrightnessSensorValueToBrightness>
        <item>-1</item> <!-- 0: OFF -->
        <item>0.0</item> <!-- 1: NIGHT, 1 nits (1-1.0)/(1250.0-1.0)*(0.68-0.0)+0.0 -->
        <item>0.0048999199</item> <!-- 2: LOW, 10 nits (10-1.0)/(1250.0-1.0)*(0.68-0.0)+0.0 -->
        <item>0.0266773419</item> <!-- 3: HIGH, 50 nits (50-1.0)/(1250.0-1.0)*(0.68-0.0)+0.0 -->
        <item>0.08112089671</item> <!-- 4: SUN, 150 nits (150-1.0)/(1250.0-1.0)*(0.68-0.0)+0.0 -->
    </dozeBrightnessSensorValueToBrightness>

    <evenDimmer enabled="true">
      <!-- (1.0-1.0)/(1250.0-1.0)*0.68 = 0.0 -->
      <transitionPoint>0.0</transitionPoint>

      <brightnessMapping>
          <brightnessPoint>
            <nits>1.0</nits>
            <backlight>0.0</backlight>
            <brightness>0.0</brightness>
          </brightnessPoint>
          <brightnessPoint>
            <nits>1250.0</nits>
            <backlight>0.68</backlight>
            <brightness>0.68</brightness>
          </brightnessPoint>
          <brightnessPoint>
            <nits>1850.0</nits>
            <backlight>1.0</backlight>
            <brightness>1.0</brightness>
          </brightnessPoint>
      </brightnessMapping>
      <luxToMinimumNitsMap>
          <point>
            <value>0</value><nits>0.24</nits>
          </point>
          <point>
            <value>10</value><nits>1.0</nits>
          </point>
          <point>
            <value>50</value><nits>2.0</nits>
          </point>
          <point>
            <value>1000</value><nits>2.0</nits>
          </point>
          <point>
            <value>3000</value><nits>2.6</nits>
          </point>
          <point>
            <value>6000</value><nits>4.8</nits>
          </point>
          <point>
            <value>10000</value><nits>7.8</nits>
          </point>
          <point>
            <value>20000</value><nits>15.0</nits>
          </point>
          <point>
            <value>50000</value><nits>36.7</nits>
          </point>
      </luxToMinimumNitsMap>
    </evenDimmer>
</displayConfiguration>
