#
# Rango sensor device configuration registry script for all stages.
#
# Source of truth: go/pixel-sensor-list
#

#
# CDT Filter <CDT>:<mask>
# CDT format: <0xPPPPSJIV> (P:Product, S:Stage, J:Major, I:Minor, V:Variant)
# go/pixel-cdt-lga
#

?+0x60000:0xFFFF0000

#
# Buses
#

# I2C
+/dev/i2c/1
  bus_name=i2c1
  bus_index=1
+/dev/i2c/2
  bus_name=i2c2
  bus_index=2

# I3C
+/dev/i3c/0
  bus_name=i3c0
  bus_index=0
+/dev/i3c/4
  bus_name=i3c4
  bus_index=4

# SPI
+/dev/spi/2
  bus_name=spi2
  bus_index=2
+/dev/spi/3
  bus_name=spi3
  bus_index=3

# PDM
+/dev/pdm
  base_clk_hz=38400000

#
# Sensors
#

# ALSP 1 (TCS3743)
+/dev/tcs3743/0
  bus_name=i2c1
  bus_freq_hz=400000
  bus_addr=0x39
  intr_id=40
  intr_gpio_id=51
  display_id=0
  priority=1
  anti_aliasing=1
  # Leakage model type to use to calculate display leakage.
  #  0 : Compensate Lux using weighted Luma.
  #  1 : Compensate Lux using legacy plus modified C-channel histogram.
  #  2 : Compensate calculated XYZ values.
  #  3 : Compensate CRGBW channels.
  leakage_model_type=3

+/dev/tcs3743/0/als
  # Lux Filter parameters
  fast_filter_size=10
  slow_filter_size=100
  aod_fast_filter_size=3
  aod_slow_filter_size=3

  # Alternate Lux equation parameters.
  # Format:
  #   per_chan_lux_coefs = <C_coef> <R_coef> <G_coef> <B_coef> <W_coef>
  #   c_g_ratio_modified_lux = r1 r2 r3 r4
  #      defined as:
  #      (C/G < r1) || (r4 < C/G)            =>  W-based  eq.
  #      (r1 < C/G < r2) || (r3 < C/G < r4)  =>  Weighted average between W-based and default eq.
  #      r2 < C/G < r3                       =>  Default eq.
  per_chan_lux_coefs=30 90 90 90 30
  c_g_ratio_modified_lux=2.4 2.8 4.8 5.2

+/dev/tcs3743/0/color
  filter_size=100
  on_change_delta=150
  freeze_cct_on_inaccurate_leakage=1

+/dev/tcs3743/0/spectral
  priority=2

# ALSP 2 (TMD3743)
+/dev/tmd3743/0
  bus_name=i2c2
  bus_freq_hz=400000
  bus_addr=0x39
  intr_id=3
  intr_gpio_id=86
  display_id=1
  anti_aliasing=1
  interlacing=1
  # Leakage model type to use to calculate display leakage.
  #  0 : Compensate Lux using weighted Luma.
  #  1 : Compensate Lux using legacy plus modified C-channel histogram.
  #  2 : Compensate calculated XYZ values.
  #  3 : Compensate CRGBW channels.
  leakage_model_type=3

+/dev/tmd3743/0/als
  priority=2
  x_scale=1.23322
  lux_scale=1.25076
  z_scale=1.25256
  x_crgbw_coefs=28.129194 -15.866833 58.052840 -61.919155 -0.299866
  lux_crgbw_coefs=22.176624 -18.114089 71.049790 -44.437884 -0.222585
  z_crgbw_coefs=55.088845 -74.953601 -28.785503 96.787072 1.888879
  # Display PWM table and dependent parameters.
  pwm_hz=240
  vsync_delay_us=4256

  # Lux Filter parameters
  fast_filter_size=10
  slow_filter_size=100
  aod_fast_filter_size=3
  aod_slow_filter_size=3

  # Alternate Lux equation parameters.
  # Format:
  #   per_chan_lux_coefs = <C_coef> <R_coef> <G_coef> <B_coef> <W_coef>
  #   c_g_ratio_modified_lux = r1 r2 r3 r4
  #      defined as:
  #      (C/G < r1) || (r4 < C/G)            =>  W-based  eq.
  #      (r1 < C/G < r2) || (r3 < C/G < r4)  =>  Weighted average between W-based and default eq.
  #      r2 < C/G < r3                       =>  Default eq.
  per_chan_lux_coefs=30 90 90 90 30
  c_g_ratio_modified_lux=2.4 2.8 4.8 5.2

  # Golden value for fac-cal leakages.
  crgbw_leakage_at_dbv=240.0000 21.58625 14.13795 4.4483 0.27585 21.77585 791.0000 240.0000 66.9483 46.91375 21.7414 9.931 65.31035 3499.0000

+/dev/tmd3743/0/prox
  auto_baseline=1
  priority=1
  gain1=128
  gain2=1
  pdata_scale=3.43355
  pdata_baseline=3930
  temp_coeff=0
  min_fps=30

+/dev/tmd3743/0/color
  priority=2
  filter_size=100
  on_change_delta=150
  freeze_cct_on_inaccurate_leakage=1

+/dev/tmd3743/0/spectral
  priority=1

# Display Info 0.
+/dev/display_info/0
  # Link to ALS attached to this display.
  attached_alsp=/dev/tcs3743/0

# Display Info 1.
+/dev/display_info/1
  # Link to ALS attached to this display.
  attached_alsp=/dev/tmd3743/0

# Virtual ALSP
+/dev/virtual_alsp/0
  als_0_display_id=0
  als_1_display_id=1
  prox_0_display_id=1
  is_color_sensor_supported=1

# IMU 0 (ICM45631)
+/dev/icm45631/0
  bus_name=i3c4
  bus_freq_hz=400000
  i3c_freq_hz=12300000
  bus_addr=0x68
  i3c_addr=0xa
  intr_id=33
  intr_gpio_id=55
  trigger_type=3
  priority=0
  spi_slew_rate_regval=5
  md_threshold=60
  md_duration_samples=1
  sd_threshold=60
  sd_timeout_ms=5000
  sd_batching_latency_ms=1000
  lowG_peak_threshold=848
  lowG_detect_timeout_ms=20
  lowG_debounce_timeout_ms=1000
+/dev/icm45631/0/accel
  orientation_transform=1 2 3
  avg_odr_25=25
  fac_cal_transform=0.99746 -0.00167 0.00418 0.00004 0.99773 -0.0007 -0.00393 0.00023 0.99779 -0.01596 0.00873 0.09584
  temp=30.89583
  temp_sensitivity=-0.00041 -0.0007 0.00106
+/dev/icm45631/0/gyro
  orientation_transform=1 2 3
  avg_odr_25=25
  fac_cal_transform=0.99798 -0.00074 0.00367 0.00217 1.0019 -0.001 -0.00407 0.00092 0.99698 0.00349 -0.00195 0.00116
  temp=30.89583
  temp_sensitivity=0.00004 -0.00003 0.00006
+/dev/icm45631/0/temp
+/dev/icm45631/0/motion_detect
+/dev/icm45631/0/stationary_detect
+/dev/icm45631/0/freefall_detect

# For MagCC
+/dev/magcc/0
  battery_status=/sys/class/power_supply/battery/status
  direct_charge=/sys/class/power_supply/dc-mains/online
  usb_status=/sys/class/power_supply/usb/online
  usb_current=/sys/class/power_supply/usb/current_now
  usb_voltage=/sys/class/power_supply/usb/voltage_now
  wireless_status=/sys/class/power_supply/wireless/online
  wireless_current=/sys/class/power_supply/wireless/current_now
  wireless_voltage=/sys/class/power_supply/wireless/voltage_now

# MAG 0 (MMC5616)
+/dev/mmc5616/0
  bus_name=i3c0
  bus_freq_hz=400000
  i3c_freq_hz=6250000
  bus_addr=0x30
  i3c_addr=0x14
+/dev/mmc5616/0/mag
  orientation_transform=-1 -2 3
  fac_cal_transform_lid_det=0.9711 0.0984 0.0102 0.0133 0.9817 -0.0078 -0.0279 0.0373 1.0437 0 0 0
  fac_cal_transform_lid_rel=0.9392 0.0863 0.012 0.0455 1.0062 -0.0197 -0.0103 0.0026 1.0359 0 0 0
  curr_comp_factors_lid_fast=-0.06 -1.18 1.3
  curr_comp_factors_fast=-0.15 -1.07 0.49
  curr_comp_factors_lid=-0.02 -1.82 2.64
  curr_comp_factors=-0.18 -1.35 0.60

# BARO (SPL07003)
+/dev/spl07003/0
  bus_name=i2c2
  bus_freq_hz=400000
  bus_addr=0x77
  intr_id=20
  intr_gpio_id=85
  coeff_a=0.0
  coeff_b=-0.000488
+/dev/spl07003/0/baro
  fac_cal_transform=1.0 -0.25538
  temp=26.88193
  temp_sensitivity=0.00135
  name=SPL07003 Barometer
+/dev/spl07003/0/temp
  name=SPL07003 Temperature

# RAINBOW (VD6282)
+/dev/vd6282/0
  bus_name=i2c2
  bus_freq_hz=400000
  bus_addr=0x20
  pdm_id=4
  pcm_rate_hz=16000

+/dev/vd6282/0/spectral
  auto_gain=1
  priority=0
  # On-change thresholds for each color channel c: min_delta[c] ratio[c].
  # A value of -1 disables a threshold.
  # Change events are determined as follows:
  #  last_count[c]: the last sample count for each channel c
  #  count[c]: the current sample count for each channel c
  #   => delta[c] = abs(last_count[c] - count[c])
  #  thresh[c] = max(min_delta[c], last_count[c] * ratio[c])
  #  if delta[c] > thresh[c] for any channel c:
  #    Send a new sample with all current channel counts
  r_change_thresh=-1 -1
  g_change_thresh=100 0.1
  b_change_thresh=-1 -1
  c1_change_thresh=100 0.1
  c2_change_thresh=-1 -1
  ir_change_thresh=-1 -1

+/dev/vd6282/0/rls
  fix_fac_cal=1

+/dev/vd6282/0/flicker
  auto_gain=1
  # Flicker capture modes:
  #  0: Normal (on-chip flicker processing, PDM converting to PCM).
  #  1: Direct1 (on-chip direct passthrough, PDM bypass, driver PCM converting).
  #  2: Direct2 (on-chip direct passthrough, PDM converting to PCM)
  flicker_mode=2
  # The PDM clock in kHz
  pdm_clock_khz=3200
  # Upshift the sample to compensate for the -6dB stage in the PDM interface.
  sample_upshift=1

# Hall Effect 1 (DRV5032)
+/dev/drv5032/1
  gpio_id=gpio62
  intr_id=24
  priority=1
  name=DRV5032 Hall Effect Sensor 1

# Camera VSYNC
+/dev/camera_vsync/0 # RUWCAM2AP_VSYNC
  intr_id=57
  intr_trigger_type=2
+/dev/camera_vsync/1 # RCAM2AP_VSYNC
  intr_id=58
  intr_trigger_type=2
+/dev/camera_vsync/2 # INNER_FCAM2AP_VSYNC
  intr_id=59
  intr_trigger_type=2
+/dev/camera_vsync/3 # OUTER_FCAM_VSYNC_1V2
  intr_id=61
  intr_trigger_type=2
+/dev/camera_vsync/4 # RTCAM2AP_VSYNC
  intr_id=62
  intr_trigger_type=2

# SX932X Sar.
+/dev/sx932x/0
  bus_name=i2c2
  bus_freq_hz=400000
  bus_addr=0x28
  intr_id=17
  intr_gpio_id=52

  # SX932X registers' field. All of these set with decimal value
  # GnrlCtrl0(0x10), [4:0], SCANPERIOD   #(HEX)0x16 = (Binary)10110    => 100 ms.
  scan_period=22
  # AfeCtrl9(0x2D),  [3:0], AGAIN        #(HEX)0x0b = (Binary)1011     => 0.768.
  analog_gain=11
  # AfeCtrl3(0x23),  [0:0], ARANGE01     #(HEX)0x01 = (Binary)1        => Large (+/-2.65pF).
  analog_range01=1
  # AfeCtrl4(0x24),  [2:0], RESOLUTION01 #(HEX)0x05 = (Binary)5        => 256.
  resolution01=5
  # AfeCtrl6(0x26),  [0:0], ARANGE23     #(HEX)0x01 = (Binary)1        => Large (+/-2.65pF).
  analog_range23=1
  # AfeCtrl7(0x27),  [2:0], RESOLUTION23 #(HEX)0x05 = (Binary)5        => 256.
  resolution23=5
  # ProxCtrl0(0x30), [5:3], GAIN01       #(HEX)0x10 = (Binary)01000    => x1 (off).
  gain01=8
  # ProxCtrl0(0x30), [2:0], RAWFILT01    #(HEX)0x03 = (Binary)001      => 1-1/2.
  raw_filt01=1
  # ProxCtrl1(0x31), [5:3], GAIN23       #(HEX)0x10 = (Binary)01000    => x1 (off).
  gain23=8
  # ProxCtrl1(0x31), [2:0], RAWFILT23    #(HEX)0x03 = (Binary)001      => 1-1/2.
  raw_filt23=1
  # ProxCtrl6(0x36), [7:0], PROXTHRESH01 #(HEX)0x16 = (Binary)00010110 => (22^2)/2 = 242
  prox_threshold01=22
  # ProxCtrl7(0x37), [7:0], PROXTHRESH23 #(HEX)0x16 = (Binary)00010110 => (22^2)/2 = 242
  prox_threshold23=22

  # Hall sensor ID used for phone case detection of on sx932x.
  # TODO(b/400327608) remove hall_sensor_id after P25 AoC been updated.
  hall_sensor_id=1
  case_hall_sensor_id=1
  # AdvCtrl16(0x50), [3:2], STEADYWINDOW   #(HEX)0x00 = (Binary)0    => 4 samples.
  steady_window=0
  # AdvCtrl17(0x51), [7:4], STEADYMAXVAR01 #(HEX)0x08 = (Binary)1000 => 128.
  steady_max_var01=8
  # AdvCtrl17(0x51), [3:0], STEADYMAXVAR23 #(HEX)0x08 = (Binary)1000 => 128.
  steady_max_var23=8
+/dev/sx932x/0/ph1
  name=SX932X SAR Sensor 0
  priority=0
+/dev/sx932x/0/ph2
  name=SX932X SAR Sensor 1
  priority=1

