service vendor.usb-gadget-hal /vendor/bin/hw/android.hardware.usb.gadget-service
    class hal
    user system
    group system shell mtp aoad

on post-fs
    chown root system /sys/class/typec/port0/power_role
    chown root system /sys/class/typec/port0/data_role
    chown root system /sys/class/typec/port0/port_type
    chown root system /sys/devices/platform/10d60000.hsi2c/i2c-2/i2c-max77759tcpc/contaminant_detection

    chmod 664 /sys/class/typec/port0/power_role
    chmod 664 /sys/class/typec/port0/data_role
    chmod 664 /sys/class/typec/port0/port_type

on property:vendor.usb.gadget.prepare=1
    chown system system /proc/irq/${vendor.usb.irq.number}/smp_affinity
    chown system system /proc/irq/${vendor.usb.irq.number}/smp_affinity_list
    setprop vendor.usb.irq.ready 1
    setprop vendor.usb.gadget.prepare 0
